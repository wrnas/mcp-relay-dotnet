{
  "ad_ldap_get_user": {
    "desc": "按AD登录账号查询用户姓名、邮箱、部门、启用状态与锁定状态（只读）",
    "domain": "active-directory",
    "params": {
      "username": "string sAMAccountName登录账号"
    },
    "ldap_server": "CORP_AD",
    "ldap_filter": "(&(objectCategory=person)(objectClass=user)(sAMAccountName={username}))",
    "ldap_scope": "sub",
    "ldap_attributes": [
      "sAMAccountName",
      "displayName",
      "mail",
      "department",
      "title",
      "userAccountControl",
      "msDS-User-Account-Control-Computed",
      "accountExpires",
      "pwdLastSet"
    ],
    "risk": "read"
  },
  "ad_ldap_search_users": {
    "desc": "按姓名片段查询AD用户，返回匹配用户的登录名与邮箱（只读，姓名片段按字面值匹配）",
    "domain": "active-directory",
    "params": {
      "name": "string 用户显示姓名片段"
    },
    "ldap_server": "CORP_AD",
    "ldap_filter": "(&(objectCategory=person)(objectClass=user)(displayName=*{name}*))",
    "ldap_attributes": [
      "sAMAccountName",
      "displayName",
      "mail",
      "department"
    ],
    "risk": "read"
  },
