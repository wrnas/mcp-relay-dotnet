{
  "ad_ensure_user_in_group": {
    "desc": "检查用户是否已在指定组，不在则加入（直接成员）",
    "domain": "active-directory",
    "params": {
      "username": "string AD登录名",
      "group": "string 组sAMAccountName、CN或完整DN"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "ensure_user_in_group",
    "risk": "write"
  },
  "ad_remove_user_from_group": {
    "desc": "从AD组移除指定用户（不是直接成员则不修改）",
    "domain": "active-directory",
    "params": {
      "username": "string AD登录名",
      "group": "string 组sAMAccountName、CN或完整DN"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "remove_user_from_group",
    "risk": "write"
  },
  "ad_ensure_user_in_ou": {
    "desc": "用户不在目标OU直属位置时移动到该OU",
    "domain": "active-directory",
    "params": {
      "username": "string AD登录名",
      "ouDn": "string 目标OU完整DN"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "ensure_user_in_ou",
    "risk": "write"
  },
  "ad_create_user": {
    "desc": "创建默认禁用的AD用户；后续可单独设置密码并启用",
    "domain": "active-directory",
    "params": {
      "username": "string 新用户sAMAccountName",
      "cn": "string 新用户CN",
      "ouDn": "string 目标OU完整DN",
      "displayName": "?string 显示名",
      "mail": "?string 邮箱",
      "department": "?string 部门"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "create_user",
    "risk": "write"
  },
  "ad_delete_user": {
    "desc": "删除指定登录名的AD用户（不可自动恢复）",
    "domain": "active-directory",
    "params": {
      "username": "string AD登录名"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "delete_user",
    "risk": "write"
  },
  "ad_set_user_attribute": {
    "desc": "修改用户普通属性，如部门、职位、邮箱、电话等",
    "domain": "active-directory",
    "params": {
      "username": "string AD登录名",
      "attribute": "string 属性名",
      "value": "string 新值，空字符串表示清空"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "set_user_attribute",
    "risk": "write"
  },
  "ad_enable_user": {
    "desc": "启用已禁用的AD账号",
    "domain": "active-directory",
    "params": {
      "username": "string AD登录名"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "enable_user",
    "risk": "write"
  },
  "ad_disable_user": {
    "desc": "禁用AD账号",
    "domain": "active-directory",
    "params": {
      "username": "string AD登录名"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "disable_user",
    "risk": "write"
  },
  "ad_unlock_user": {
    "desc": "解锁AD账号",
    "domain": "active-directory",
    "params": {
      "username": "string AD登录名"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "unlock_user",
    "risk": "write"
  },
  "ad_reset_user_password": {
    "desc": "重置AD用户密码（要求LDAPS；建议仅在可信证书连接下操作）",
    "domain": "active-directory",
    "params": {
      "username": "string AD登录名",
      "password": "string 新密码"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "reset_user_password",
    "risk": "write"
  },
  "ad_create_group": {
    "desc": "创建全局安全组",
    "domain": "active-directory",
    "params": {
      "cn": "string 新组CN",
      "ouDn": "string 目标OU完整DN",
      "samAccountName": "?string 组sAMAccountName（默认同cn）",
      "description": "?string 组描述"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "create_group",
    "risk": "write"
  },
  "ad_delete_group": {
    "desc": "按名称或DN删除指定AD组",
    "domain": "active-directory",
    "params": {
      "group": "string 组sAMAccountName、CN或完整DN"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "delete_group",
    "risk": "write"
  },
  "ad_set_group_description": {
    "desc": "按名称或DN修改AD组描述",
    "domain": "active-directory",
    "params": {
      "group": "string 组sAMAccountName、CN或完整DN",
      "description": "string 描述，空字符串表示清空"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "set_group_description",
    "risk": "write"
  },
  "ad_create_ou": {
    "desc": "在指定父容器下新建OU",
    "domain": "active-directory",
    "params": {
      "ou": "string OU名称",
      "parentDn": "string 父OU或域DN"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "create_ou",
    "risk": "write"
  },
  "ad_delete_ou": {
    "desc": "删除空OU（不会递归删除）",
    "domain": "active-directory",
    "params": {
      "ouDn": "string 要删除的OU完整DN"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "delete_ou",
    "risk": "write"
  },
  "ad_enable_computer": {
    "desc": "启用指定AD计算机账号",
    "domain": "active-directory",
    "params": {
      "computerName": "string 计算机sAMAccountName（可不带$）"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "enable_computer",
    "risk": "write"
  },
  "ad_disable_computer": {
    "desc": "禁用指定AD计算机账号",
    "domain": "active-directory",
    "params": {
      "computerName": "string 计算机sAMAccountName（可不带$）"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "disable_computer",
    "risk": "write"
  },
  "ad_delete_computer": {
    "desc": "删除指定AD计算机账号",
    "domain": "active-directory",
    "params": {
      "computerName": "string 计算机sAMAccountName（可不带$）"
    },
    "ldap_server": "CORP_AD",
    "ldap_action": "delete_computer",
    "risk": "write"
  }
}
